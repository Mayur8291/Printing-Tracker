{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/squad/:path*", "destination": "/index.html" },
    { "source": "/account/:path*", "destination": "/index.html" }
  ],
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "apps/admin/dist",
  "installCommand": "npm ci"
}
