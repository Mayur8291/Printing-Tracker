{
  "name": "canto-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace @canto/admin",
    "dev:vite": "npm run dev:vite --workspace @canto/admin",
    "dev:staging": "npm run dev:staging --workspace @canto/admin",
    "dev:mobile": "npm run start --workspace @canto/mobile",
    "build": "npm run build --workspace @canto/admin",
    "check:ui": "node scripts/check-ui-gate.mjs",
    "check:env": "node scripts/check-dev-env.mjs",
    "preview": "npm run preview --workspace @canto/admin",
    "check:mobile": "npm run typecheck --workspace @canto/mobile",
    "export:mobile": "npm run export --workspace @canto/mobile"
  }
}
