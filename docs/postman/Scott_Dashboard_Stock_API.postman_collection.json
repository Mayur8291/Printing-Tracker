    {
      "name": "Webhooks (dashboard → your server)",
      "description": "OUTBOUND — these are the requests the DASHBOARD sends to the Scott backend. They are included here as mock examples so your team can see exact payloads and build/test the receiver (point `scott_webhook_base_url` at a mock server or webhook.site).\n\nEvery request is signed: `X-Dashboard-Signature: sha256=<hmac-sha256-hex(rawBody, SCOTT_WEBHOOK_SECRET)>`. Respond 2xx; anything else is retried from the outbox on the next stock/order mutation.",
      "item": [
        {
          "name": "POST order.status_changed (example payload)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Dashboard-Signature", "value": "sha256=<computed by dashboard>", "description": "HMAC-SHA256 of raw body with SCOTT_WEBHOOK_SECRET" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"order.status_changed\",\n  \"event_id\": \"evt_pqr678\",\n  \"occurred_at\": \"2026-07-20T14:00:00Z\",\n  \"dashboard_order_id\": \"ord_abc123\",\n  \"order_code\": \"P-53011\",\n  \"previous_status\": \"PROCESSING\",\n  \"status\": \"COMPLETE\",\n  \"dispatched_at\": \"2026-07-20T14:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{scott_webhook_base_url}}/webhooks/orders/status_changed",
              "host": ["{{scott_webhook_base_url}}"],
              "path": ["webhooks", "orders", "status_changed"]
            },
            "description": "Fired on EVERY status transition (PENDING → PROCESSING → COMPLETE, or → CANCELLED / FAILED). `dispatched_at` present only when status is COMPLETE. Respond `200 { \"received\": true }`."
          },
          "response": []
        },
        {
          "name": "POST stock.level_changed (example payload)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Dashboard-Signature", "value": "sha256=<computed by dashboard>", "description": "HMAC-SHA256 of raw body with SCOTT_WEBHOOK_SECRET" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"stock.level_changed\",\n  \"event_id\": \"evt_abc123\",\n  \"occurred_at\": \"2026-07-20T14:00:00Z\",\n  \"facility_code\": \"SCOTT_1DAY_01\",\n  \"trigger\": \"RESERVATION\",\n  \"changed_skus\": [\n    {\n      \"sku_code\": \"SKU-COTTON-WHT-M\",\n      \"previous_stock\": 120,\n      \"current_stock\": 119\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{scott_webhook_base_url}}/webhooks/stock/level_changed",
