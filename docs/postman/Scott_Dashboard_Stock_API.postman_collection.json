        {
          "name": "4. Mark COMPLETE (dispatch)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"COMPLETE\" }"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{dashboard_order_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{dashboard_order_id}}", "status"]
            }
          },
          "response": []
        },
        {
          "name": "4 alt. Cancel instead",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{dashboard_order_id}}?reason=CUSTOMER_CANCELLED",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{dashboard_order_id}}"],
              "query": [
                { "key": "reason", "value": "CUSTOMER_CANCELLED" }
              ]
            }
          },
          "response": []
