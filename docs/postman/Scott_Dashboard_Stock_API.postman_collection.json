  "item": [
    {
      "name": "Stock",
      "item": [
        {
          "name": "GET Snapshot — single SKU + facility",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stock/snapshot?skus={{sku_code}}&facility={{facility_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "snapshot"],
              "query": [
                { "key": "skus", "value": "{{sku_code}}" },
                { "key": "facility", "value": "{{facility_code}}" }
              ]
            },
            "description": "Available qty = on_hand − reserved. Response keys: `FACILITY:SKU_CODE`."
          },
          "response": []
        },
        {
          "name": "GET Snapshot — multiple SKUs (all facilities)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stock/snapshot?skus={{sku_code}},{{sku_code_2}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "snapshot"],
              "query": [
                { "key": "skus", "value": "{{sku_code}},{{sku_code_2}}" }
              ]
            },
            "description": "Omit `facility` to return all facilities for listed SKUs."
          },
          "response": []
        },
        {
          "name": "POST Reserve stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.reservation_id) {",
                  "    pm.collectionVariables.set('reservation_id', body.reservation_id);",
                  "    pm.environment.set('reservation_id', body.reservation_id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_code\": \"{{order_code}}\",\n  \"facility_code\": \"{{facility_code}}\",\n  \"items\": [\n    {\n      \"sku_code\": \"{{sku_code}}\",\n      \"item_code\": \"P-1-4201-88\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stock/reserve",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "reserve"]
            },
            "description": "Hold stock for RMP order. **201** on success. **409 INSUFFICIENT_STOCK** if short.\n\nTest script saves `reservation_id` for release/fulfill requests."
          },
          "response": []
        },
        {
          "name": "DELETE Release reservation — CANCELLED",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stock/reserve/{{reservation_id}}?reason=CANCELLED",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "reserve", "{{reservation_id}}"],
              "query": [
                { "key": "reason", "value": "CANCELLED" }
              ]
            },
            "description": "Release reserved stock. Idempotent if already released."
          },
          "response": []
        },
        {
          "name": "DELETE Release reservation — ORDER_EDIT",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stock/reserve/{{reservation_id}}?reason=ORDER_EDIT",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "reserve", "{{reservation_id}}"],
              "query": [
                { "key": "reason", "value": "ORDER_EDIT" }
              ]
            },
            "description": "Release when order line items change."
          },
          "response": []
        },
        {
          "name": "POST Fulfill reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispatched_at\": \"2026-06-30T14:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stock/fulfill/{{reservation_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "fulfill", "{{reservation_id}}"]
            },
            "description": "Deduct reserved stock when order dispatches. Body optional."
          },
          "response": []
        },
        {
          "name": "POST Adjust stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"facility_code\": \"{{facility_code}}\",\n  \"reason\": \"DAMAGE_WRITE_OFF\",\n  \"items\": [\n    { \"sku_code\": \"{{sku_code}}\", \"delta\": -1 },\n    { \"sku_code\": \"{{sku_code_2}}\", \"delta\": 10 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stock/adjust",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "adjust"]
            },
            "description": "Manual +/- correction. Negative delta cannot leave on_hand below reserved."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "description": "Order lifecycle (order-api-requirements.html). Statuses: PENDING → PROCESSING → COMPLETE, or CANCELLED / FAILED (terminal).",
      "item": [
        {
          "name": "POST Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.dashboard_order_id) {",
                  "    pm.collectionVariables.set('dashboard_order_id', body.dashboard_order_id);",
                  "    pm.environment.set('dashboard_order_id', body.dashboard_order_id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_code\": \"{{order_code}}\",\n  \"facility_code\": \"{{facility_code}}\",\n  \"due_on\": \"2026-07-25T00:00:00Z\",\n  \"customer\": {\n    \"code\": \"P-104\",\n    \"name\": \"Acme Traders\",\n    \"email\": \"acme@example.com\",\n    \"phone\": \"9876543210\"\n  },\n  \"shipping_address\": {\n    \"name\": \"Acme Traders\",\n    \"address_line1\": \"12 MG Road\",\n    \"city\": \"Pune\",\n    \"state\": \"MH\",\n    \"country\": \"IN\",\n    \"pincode\": \"411001\",\n    \"phone\": \"9876543210\",\n    \"email\": \"acme@example.com\"\n  },\n  \"payment\": {\n    \"instrument\": \"CASH\",\n    \"cash_on_delivery\": true\n  },\n  \"comment\": \"Rush order - dispatch by Friday\",\n  \"items\": [\n    {\n      \"item_code\": \"P-1-4201-88\",\n      \"sku_code\": \"{{sku_code}}\",\n      \"quantity\": 1,\n      \"unit_price\": 245.50\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Create RMP order + hold stock. **201** with `dashboard_order_id` (test script saves it). **409 INSUFFICIENT_STOCK** with per-SKU details; **409 ORDER_EXISTS** when an open order already uses this `order_code`."
          },
          "response": []
        },
        {
          "name": "GET Order (status + items)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{dashboard_order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{dashboard_order_id}}"]
            },
            "description": "Current status + items with `dispatched_quantity`. For reconciliation/support — status changes are pushed via the `order.status_changed` webhook."
          },
          "response": []
        },
        {
          "name": "PATCH Update order (items / address / due_on)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"due_on\": \"2026-07-27T00:00:00Z\",\n  \"shipping_address\": {\n    \"name\": \"Acme Traders\",\n    \"address_line1\": \"14 FC Road\",\n    \"city\": \"Pune\",\n    \"state\": \"MH\",\n    \"country\": \"IN\",\n    \"pincode\": \"411004\"\n  },\n  \"items\": [\n    {\n      \"item_code\": \"P-1-4201-88\",\n      \"sku_code\": \"{{sku_code}}\",\n      \"quantity\": 2,\n      \"unit_price\": 245.50\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{dashboard_order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{dashboard_order_id}}"]
            },
            "description": "Full replace of `items` / `shipping_address` / `due_on` (omitted fields untouched). Old stock hold released, new hold created. **409 ORDER_NOT_EDITABLE** when COMPLETE/CANCELLED/FAILED; **409 INSUFFICIENT_STOCK** if the new quantities don't fit."
          },
          "response": []
        },
        {
          "name": "DELETE Cancel order",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{dashboard_order_id}}?reason=CUSTOMER_CANCELLED",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{dashboard_order_id}}"],
              "query": [
                { "key": "reason", "value": "CUSTOMER_CANCELLED", "description": "or ORDER_EDIT, OUT_OF_STOCK" }
              ]
            },
            "description": "Cancel + release held stock. **Idempotent** — repeating returns 200 with the original `cancelled_at`. **409 ORDER_NOT_EDITABLE** when already COMPLETE/FAILED."
          },
          "response": []
        },
        {
          "name": "POST Set status — PROCESSING (internal)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PROCESSING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{dashboard_order_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{dashboard_order_id}}", "status"]
            },
            "description": "Dashboard-internal transition endpoint (not in the Scott spec). PROCESSING allowed from PENDING only. Fires `order.status_changed` webhook."
          },
          "response": []
        },
        {
          "name": "POST Set status — COMPLETE (internal, fulfills stock)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETE\",\n  \"dispatched_at\": \"2026-07-20T14:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{dashboard_order_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{dashboard_order_id}}", "status"]
            },
            "description": "Terminal. Fulfills the reservation (on-hand permanently deducted), sets `dispatched_at` and items' `dispatched_quantity`. `dispatched_at` optional (defaults to now)."
          },
          "response": []
        },
        {
          "name": "POST Set status — FAILED (internal, releases stock)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FAILED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{dashboard_order_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{dashboard_order_id}}", "status"]
            },
            "description": "Terminal. Releases the stock hold back to available."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Order happy path flow",
      "description": "Run in order: Create → Get → PROCESSING → COMPLETE. (Or DELETE to cancel instead.) `dashboard_order_id` is saved automatically by the Create request.",
      "item": [
        {
          "name": "1. Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('dashboard_order_id', body.dashboard_order_id);",
                  "  pm.environment.set('dashboard_order_id', body.dashboard_order_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_code\": \"{{order_code}}\",\n  \"facility_code\": \"{{facility_code}}\",\n  \"customer\": { \"code\": \"P-104\", \"name\": \"Acme Traders\" },\n  \"payment\": { \"instrument\": \"CASH\", \"cash_on_delivery\": true },\n  \"items\": [\n    { \"item_code\": \"P-1-4201-88\", \"sku_code\": \"{{sku_code}}\", \"quantity\": 1, \"unit_price\": 245.50 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            }
          },
          "response": []
        },
        {
          "name": "2. Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{dashboard_order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{dashboard_order_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "3. Mark PROCESSING",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
